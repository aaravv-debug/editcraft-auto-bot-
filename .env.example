# Google Gemini AI API Key (Free: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud OAuth2 Credentials (Create once in Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Optional: Custom Redirect URI (defaults automatically to https://<railway-domain>/auth/google/callback)
# REDIRECT_URI=https://your-app.up.railway.app/auth/google/callback

# Background check interval in minutes (default: 15)
CHECK_INTERVAL_MINUTES=15
PORT=3000
